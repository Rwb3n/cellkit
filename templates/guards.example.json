{
  "operator_only": [
    { "command": "tools/release.ts publish", "message": "publishing is the operator's. Show them the draft, then ask them to run it from their prompt: ! node tools/release.ts publish --draft <slug>" },
    { "pattern": "\\bgit\\s+push\\s+(-f|--force)\\b", "message": "force-pushing is the operator's." }
  ],
  "protected": [
    { "path": "docs/report/", "by": "tools/report.ts" },
    { "path": "docs/models/trace.md" }
  ],
  "mail": { "log": "body" },
  "unreadable": [
    { "path": "OTHER_PROJECT/vault/", "why": "another project's vault" },
    { "path": "records/*bank*", "why": "bank records" }
  ],
  "worktrees": { "home": "../.cells/myproject" },
  "land": { "ignored": ["**/node_modules/**", "**/__pycache__/**", "**/.pytest_cache/**", "cells/*/state/out/**"] }
}
